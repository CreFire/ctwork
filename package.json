{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node api.js && vite",
    "dev:full": "node api.js && concurrently \"npm run server:dev\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview",
    "gen:luban": "node scripts/luban-gen.mjs",
    "gen": "npm run gen:luban",
    "validate:config": "node scripts/validate-config.mjs",
    "server:dev": "cd server/node && npm install --silent && node src/index.mjs",
    "server:install": "cd server/node && npm install",
    "league:dev": "npm run server:dev"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.43.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
