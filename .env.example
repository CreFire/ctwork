# 方舟纪元环境变量示例

# === 前端 → 后端 API ===
# 前端 → 后端 API 地址(默认空 = 同源; dev 环境由 vite 代理 /api → 127.0.0.1:8090 或 3001)
VITE_API_BASE=
# 排行榜后端地址 (兼容旧版，新版用 VITE_API_BASE)
VITE_API_URL=http://localhost:3001

# 1 = 使用前端内置 mockServer(纯前端离线演示)
# 0/空 = 连接正式 dueGame 后端(server/)
VITE_USE_MOCK=

# === 后端 ===
# 后端端口 (Go 后端默认 8090, Node 排行榜后端默认 3001)
PORT=3001
HOST=0.0.0.0

# MongoDB (Go 后端使用)
# MONGO_URL=mongodb://localhost:27017/ark_era
MONGO_URL=mongodb://localhost:27017/ark_era
MONGO_DB=ark_era

# JWT
JWT_SECRET=dev_secret_change_in_prod
